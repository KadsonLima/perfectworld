[LogserviceServer]
type			=	udp
port			=	$LOGSERVICE_SERVER_UDP_PORT
address			=	$LOGSERVICE_SERVER_ADDRESS
so_sndbuf		=	16384
so_rcvbuf		=	16384
ibuffermax		=	2097152
obuffermax		=	16384
tcp_nodelay		=	0
listen_backlog	=	10
accumulate		=	2097152

[LogserviceTcpServer]
type			=	tcp
port			=	$LOGSERVICE_SERVER_TCP_PORT
address			=	$LOGSERVICE_SERVER_ADDRESS
so_sndbuf		=	65536
so_rcvbuf		=	65536
ibuffermax		=	2097152
obuffermax		=	16384
tcp_nodelay		=	0
listen_backlog	=	10
accumulate		=	2097152

[logservice]
threshhold		=	LOG_DEBUG
fd_err			=	/dev/stdout
fd_log			=	/dev/stdout
fd_formatlog	=	/dev/stdout
fd_trace		=	/dev/stdout
fd_chat			=	/dev/stdout
fd_cash			=	/dev/stdout
fd_statinfom	=	/dev/stdout
fd_statinfoh	=	/dev/stdout
fd_statinfod	=	/dev/stdout

[ThreadPool]
threads			=	(0,1)(1,5)
max_queuesize	=	1048576

