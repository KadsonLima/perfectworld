;Only client-end will use this configure file
;Client is GameServer, the sessions below are linkservers that gameserver should connect

[ProviderServers]
count=10

;this must be delivery server
[GProviderClient0]
type			=	tcp
port			=	$GDELIVERYD_PROVIDER_SERVER_PORT
address			=	$GDELIVERYD_SERVER_ADDRESS
so_sndbuf		=	65536
so_rcvbuf		=	65536
ibuffermax		=	1048576
obuffermax		=	1048576
tcp_nodelay		=	1
listen_backlog	=	10
accumulate		=	104857600

